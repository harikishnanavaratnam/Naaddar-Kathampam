# ── Astro / Sanity (public, read-only content) ──
# Leave blank to run the site from local placeholder content (src/data/content.ts).
# Fill these once your Sanity Studio has content, to read live from the CMS.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# ── Contact form ──
# Web3Forms access key. The recipient email is configured in the Web3Forms
# dashboard against this key — it is intentionally NOT stored in Sanity.
PUBLIC_WEB3FORMS_KEY=
